# Copy to `.env` and adjust if the API moves.
# The browser never talks to this host directly: Next.js rewrites `/api/*`
# to it server-side so the API's SameSite=Lax session cookie stays same-origin.
API_URL=https://receipt-backend-1-biue.onrender.com/api

# Public origin of this app. Used only to resolve absolute URLs in the
# document head (the Open Graph image social scrapers read). Defaults to
# http://localhost:3000 when unset.
SITE_URL=http://localhost:3000
